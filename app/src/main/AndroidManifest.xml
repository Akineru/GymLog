<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 13+: posting the timer-finished notification needs this at runtime. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarm-clock style app: granted at install, cannot be revoked by the user.
         SCHEDULE_EXACT_ALARM is denied by default from Android 14, so this is the
         permission to rely on for exact countdown delivery. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Ongoing "training in progress" notification.
         specialUse is used instead of health: health additionally requires a
         sensor-related runtime permission (ACTIVITY_RECOGNITION / BODY_SENSORS or the
         HIGH_SAMPLING_RATE_SENSORS manifest declaration), and this app reads no sensors. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".GymLogApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GymLog">
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/photo_file_paths" />
        </provider>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.GymLog"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".data.TimerAlarmReceiver"
            android:exported="false" />
        <!-- 只服务「正在训练」通知：点击回训练、划掉通知后的记录 -->
        <service
            android:name=".data.WorkoutNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="active_workout_session_timer" />
        </service>
        <receiver
            android:name=".data.WorkoutNotificationReceiver"
            android:exported="false" />
    </application>

</manifest>